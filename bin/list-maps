#!/usr/bin/env python3
"""Print the minimap's maps as JSON: every maps/<dir>/map.json, sorted by
order then name. A folder without a valid map.json, or whose entry file is
missing, is skipped. A map folder can be a symlink (a plugin shipping its
own map): paths are resolved so the map's relative imports reach its real
home."""
import json
import os
import sys

root = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "maps")
out = []
for name in sorted(os.listdir(root)) if os.path.isdir(root) else []:
    folder = os.path.join(root, name)
    try:
        with open(os.path.join(folder, "map.json"), encoding="utf-8") as f:
            meta = json.load(f)
    except (OSError, ValueError):
        continue
    if not isinstance(meta, dict):
        continue
    entry = str(meta.get("entry") or "Map.qml")
    path = os.path.realpath(os.path.join(folder, entry))
    if not os.path.isfile(path):
        continue
    icon = str(meta.get("icon") or "")
    is_file = icon.lower().endswith((".svg", ".png"))
    try:
        order = float(meta.get("order", 100))
    except (TypeError, ValueError):
        order = 100
    out.append({
        "id": str(meta.get("id") or name),
        "name": str(meta.get("name") or name),
        "glyph": "" if is_file else icon,
        "image": "file://" + os.path.realpath(os.path.join(folder, icon)) if is_file and icon else "",
        "url": "file://" + path,
        "order": order,
    })
out.sort(key=lambda m: (m["order"], m["name"].lower()))
json.dump(out, sys.stdout, ensure_ascii=False)
