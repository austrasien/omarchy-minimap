#!/usr/bin/env bash
# Prints "width height path" for Omarchy's current background; width and
# height are 0 0 when the image cannot be read.
path=$(readlink -f "$HOME/.local/state/omarchy/current/background") || exit 0
[[ -f $path ]] || exit 0
size=$(magick identify -ping -format '%w %h' "$path[0]" 2>/dev/null) || size="0 0"
echo "${size:-0 0} $path"
